# Chatwoot production environment template.
#
# Copy to `.env` next to docker-compose.production.yaml on the server:
#
#   cp deployment/env.production.example .env
#
# Then fill in every value marked REQUIRED. Never commit the resulting .env —
# it holds live credentials, and .gitignore already excludes it.
#
# Generate secrets ON THE SERVER, not in a chat window or a shared document.

# ---------------------------------------------------------------------------
# Core (REQUIRED)
# ---------------------------------------------------------------------------

# REQUIRED. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# REQUIRED. The public HTTPS URL of this installation. Meta/WhatsApp webhooks
# will not register against an IP address or a plain-http URL, so a real
# domain with a valid certificate is mandatory for those channels.
FRONTEND_URL=https://chat.example.com

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

# Redirect http -> https at the app layer. Leave true behind the nginx config
# in deployment/nginx_chatwoot.conf.
FORCE_SSL=true

# true      - anyone can self-register an account
# false     - signups disabled entirely
# api_only  - no signup UI, but accounts can still be created via the Platform API
#             (this is the setting to use when your own control plane provisions
#             tenants; see docs/PROJECT-AUDIT.md)
ENABLE_ACCOUNT_SIGNUP=false

# Default locale for new accounts.
DEFAULT_LOCALE=en

# ---------------------------------------------------------------------------
# Encryption (REQUIRED — MFA/2FA fails without these)
# ---------------------------------------------------------------------------
# Generate all three at once, on the server, with:
#   docker compose -f docker-compose.production.yaml run --rm \
#     rails bundle exec rails db:encryption:init
#
# Losing these makes every encrypted column unreadable. Back them up somewhere
# durable before going live, and use different keys per environment.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# ---------------------------------------------------------------------------
# PostgreSQL (REQUIRED)
# ---------------------------------------------------------------------------
# `postgres` is the compose service name. Point this at a managed database
# host instead if you are not running Postgres in compose.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot_production

# REQUIRED. Generate with: openssl rand -hex 24
# docker-compose.production.yaml ships this EMPTY, which leaves the database
# open to anything that can reach the container. It must be set, and the same
# value must appear in the postgres service's POSTGRES_PASSWORD.
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Redis (REQUIRED)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# REQUIRED. Generate with: openssl rand -hex 24
# The redis service starts with --requirepass "$REDIS_PASSWORD", so an empty
# value means an unauthenticated Redis.
REDIS_PASSWORD=

# ---------------------------------------------------------------------------
# Outbound mail (REQUIRED for invites, password resets, notifications)
# ---------------------------------------------------------------------------
# DigitalOcean blocks outbound port 25 on Droplets, so use a relay
# (SES / Mailgun / Postmark / SendGrid) rather than a local MTA.
MAILER_SENDER_EMAIL=Support <support@example.com>
SMTP_DOMAIN=example.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer

# Inbound email (replies-to-conversation). Optional; needs MX records.
MAILER_INBOUND_EMAIL_DOMAIN=
RAILS_INBOUND_EMAIL_SERVICE=
RAILS_INBOUND_EMAIL_PASSWORD=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# `local` keeps uploads in the storage_data docker volume. That is fine for a
# single Droplet but is lost if the volume is destroyed and cannot be shared
# across multiple app servers. DigitalOcean Spaces is S3-compatible: set
# ACTIVE_STORAGE_SERVICE=s3 and fill in the AWS_* values below.
ACTIVE_STORAGE_SERVICE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# ---------------------------------------------------------------------------
# Licensing
# ---------------------------------------------------------------------------
# The chatwoot/chatwoot image bundles the enterprise/ code, which is NOT MIT
# licensed: production use requires a Chatwoot Enterprise subscription, and the
# licence forbids sublicensing or reselling it.
#
# Setting this to true runs the OSS (MIT) build only. You lose Captain AI, SLA,
# custom roles, SAML, audit logs and companies. Leave it true unless you hold a
# subscription. See enterprise/LICENSE and docs/PROJECT-AUDIT.md section 19.
DISABLE_ENTERPRISE=true

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Channel credentials (optional — add per channel you enable)
# ---------------------------------------------------------------------------
# Each of these is configurable at runtime from Super Admin -> Settings instead
# of here; values set in the UI are stored in installation_configs and take
# precedence. Webhook URLs must be publicly reachable over HTTPS.
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
